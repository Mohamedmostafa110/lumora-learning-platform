        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle LUMORA PLATFORM - COURSE CREATION &amp; ADMIN APPROVAL\nskinparam linetype ortho\nskinparam shadowing false\n\nskinparam Swimlane {\n    TitleFontColor #000000\n    TitleFontSize 15\n    BorderColor #2c384e\n    BorderThickness 2\n}\n\nskinparam Activity {\n    BackgroundColor #2b78b8\n    BorderColor #1f5a8a\n    FontColor #FFFFFF\n    FontSize 12\n    RoundCorner 25\n    DiamondBackgroundColor #d9534f\n    DiamondBorderColor #b52b27\n    BarColor #f0ad4e\n    StartColor #2c384e\n    EndColor #2c384e\n}\n\nskinparam Arrow {\n    Color #555555\n    FontColor #000000\n    FontSize 12\n}\n\n|Instructor|\nstart\n:Create Course &amp; Set Pricing/Discounts;\n:Organize Sections &amp; Lessons (Drag-and-Drop);\n:Upload Lesson Videos &amp; Create Quizzes;\n\n|Microsoft Azure|\n:Upload to Azure Blob Storage;\n:Compress Video &amp; Generate Thumbnail;\n\n|Instructor|\n:Preview Course;\n\n|Lumora Platform|\nif () then ([Save as Draft])\n    :Save Course in Draft Status;\nelse ([Submit for Approval])\n    :Set Course Status to Pending Review;\n    |Admin|\n    :Review Course Content &amp; Quality;\n    if () then ([Approved])\n        |Lumora Platform|\n        :Publish Course to Public Catalog;\n        fork\n            |Instructor|\n            :View Enrollment Stats &amp; Earnings;\n        fork again\n            |Instructor|\n            :Answer Student Q&amp;A &amp; Post Announcements;\n        end fork\n    else ([Rejected])\n        |Lumora Platform|\n        :Return Course to Instructor with Feedback;\n        |Instructor|\n        :Edit Course Content;\n    endif\nendif\n\n|Instructor|\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v281P9ACCbJfuL08H2Cz-146">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
