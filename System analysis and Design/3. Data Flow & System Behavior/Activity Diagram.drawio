        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle LUMORA PLATFORM - ADMIN OPERATIONS &amp; PUBLIC VERIFICATION\nskinparam linetype ortho\nskinparam shadowing false\n\nskinparam Swimlane {\n    TitleFontColor #000000\n    TitleFontSize 15\n    BorderColor #2c384e\n    BorderThickness 2\n}\n\nskinparam Activity {\n    BackgroundColor #2b78b8\n    BorderColor #1f5a8a\n    FontColor #FFFFFF\n    FontSize 12\n    RoundCorner 25\n    DiamondBackgroundColor #d9534f\n    DiamondBorderColor #b52b27\n    BarColor #f0ad4e\n    StartColor #2c384e\n    EndColor #2c384e\n}\n\nskinparam Arrow {\n    Color #555555\n    FontColor #000000\n    FontSize 12\n}\n\n|Guest / Registered User|\nstart\nif () then ([Public Certificate Check])\n    :Enter Certificate Verification ID;\n    |Lumora Platform|\n    :Validate Verification ID;\n    if () then ([Valid ID])\n        :Display Verified Certificate Details;\n    else ([Invalid ID])\n        :Display Invalid Certificate Alert;\n    endif\nelse ([Platform Access])\n    |Guest / Registered User|\n    :Register / Login to Account;\n    |Lumora Platform|\n    :Authenticate User (ASP.NET Identity);\n    if () then ([Admin Role])\n        |Admin|\n        fork\n            :Manage / Suspend Students &amp; Instructors;\n        fork again\n            :Manage Categories, Tags &amp; Platform Settings;\n        fork again\n            :View Analytics &amp; Sales Reports (Chart.js);\n        end fork\n    else ([Student / Instructor Role])\n        |Guest / Registered User|\n        :Manage User Profile;\n    endif\n    |Lumora Platform|\n    :Log Session Out;\nendif\n\n|Guest / Registered User|\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v281P9ACCbJfuL08H2Cz-198">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
