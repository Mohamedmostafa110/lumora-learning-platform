        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle LUMORA PLATFORM - COURSE ENROLLMENT &amp; CHECKOUT\nskinparam linetype ortho\nskinparam shadowing false\n\nskinparam Swimlane {\n    TitleFontColor #000000\n    TitleFontSize 15\n    BorderColor #2c384e\n    BorderThickness 2\n}\n\nskinparam Activity {\n    BackgroundColor #2b78b8\n    BorderColor #1f5a8a\n    FontColor #ffffff\n    FontSize 12\n    RoundCorner 25\n    DiamondBackgroundColor #d9534f\n    DiamondBorderColor #b52b27\n    BarColor #f0ad4e\n    StartColor #2c384e\n    EndColor #2c384e\n}\n\nskinparam Arrow {\n    Color #555555\n    FontColor #000000\n    FontSize 12\n}\n\n|Student|\nstart\n:Browse &amp; Select Course;\n:Click Enroll / Add to Cart;\n\n|Lumora Platform|\n:Verify Enrollment Eligibility;\n\nif () then ([Student Already Enrolled])\n    :Deny Duplicate Purchase;\n    |Student|\n    :View Error Message;\n    stop\nelse ([Eligible to Enroll])\n    |Lumora Platform|\n    :Check Course Pricing Type;\n    if () then ([Free Course])\n        :Enroll Student in Free Course;\n    else ([Paid Course])\n        |Student|\n        :Proceed to Cart &amp; Checkout;\n        if () then ([Apply Coupon])\n            :Enter Promo Code;\n            |Lumora Platform|\n            :Calculate Discount (Strategy Pattern);\n        else ([No Coupon])\n        endif\n        |Stripe &amp; Notification Server|\n        :Process Payment via Stripe;\n        if () then ([Valid Payment])\n            fork\n                |Student|\n                :View Payment Confirmation;\n            fork again\n                |Lumora Platform|\n                :Grant Course Access &amp; Save Receipt;\n                |Stripe &amp; Notification Server|\n                :Send Payment Receipt Email;\n            end fork\n        else ([Payment Failed])\n            |Lumora Platform|\n            :Strictly Deny Course Access;\n            |Student|\n            :View Payment Failed Error;\n            stop\n        endif\n    endif\nendif\n\n|Lumora Platform|\n:Unlock Course Lessons;\n\n|Student|\n:Access Course Player;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v281P9ACCbJfuL08H2Cz-1">
